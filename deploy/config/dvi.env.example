# Copiar para /etc/dvi/dvi.env (permissão 0600). NÃO versionar o arquivo real.
# A URL do banco (com senha) é entregue como segredo Podman "dvi_database_url".
DVI_MAX_UPLOAD_MB=25
DVI_SESSION_HOURS=12
# true quando o Nginx estiver servindo HTTPS com certificado institucional
DVI_COOKIE_SECURE=false
DVI_APP_ENV=production
