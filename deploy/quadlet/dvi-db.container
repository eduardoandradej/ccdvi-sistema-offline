[Unit]
Description=DVI Offline - PostgreSQL

[Container]
ContainerName=dvi-db
Image=docker.io/library/postgres:16-bookworm
Network=dvi.network
Volume=dvi-db.volume:/var/lib/postgresql/data
Environment=POSTGRES_USER=dvi POSTGRES_DB=dvi POSTGRES_PASSWORD_FILE=/run/secrets/dvi_db_password
Secret=dvi_db_password
HealthCmd=pg_isready -U dvi -d dvi
HealthInterval=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
