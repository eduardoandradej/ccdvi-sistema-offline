# Desenvolvimento local (scripts/dev-up.sh). Copie para backend/.env e ajuste.
# Nenhuma senha real deve ser versionada.
DVI_DATABASE_URL=postgresql+psycopg://dvi:TROQUE_ESTA_SENHA@localhost:5432/dvi
DVI_STORAGE_DIR=./var/storage
DVI_MAX_UPLOAD_MB=25
DVI_SESSION_HOURS=12
DVI_COOKIE_SECURE=false
# Senha dos usuários de laboratório criados por "python -m app.seed" (mín. 10 caracteres).
# Se ausente, o seed gera uma senha aleatória e a exibe uma única vez.
# DVI_SEED_PASSWORD=
